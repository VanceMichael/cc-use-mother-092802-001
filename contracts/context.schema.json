{
  "title": "央企人工智能资源普惠开放治理领域上下文",
  "type": "object",
  "required": [
    "domain",
    "version",
    "actors",
    "facts",
    "constraints",
    "record_chain",
    "rule_tracks",
    "continuity"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "const": "inclusive-ai-resource-hub"
    },
    "version": {
      "type": "integer",
      "minimum": 2
    },
    "actors": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "facts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "string"
      }
    },
    "record_chain": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["order", "link", "records"],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "link": {
            "type": "string"
          },
          "records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "rule_tracks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "applies_to", "rule_points"],
        "properties": {
          "name": {
            "type": "string"
          },
          "applies_to": {
            "type": "string"
          },
          "rule_points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "continuity": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["object", "resume_action", "must_not_lose"],
        "properties": {
          "object": {
            "type": "string"
          },
          "resume_action": {
            "type": "string"
          },
          "must_not_lose": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
